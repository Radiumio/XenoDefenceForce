		class Item37
		{
			dataType="Trigger";
			position[]={5864.9751,236.97832,4397.5181};
			angle=4.1300945;
			class Attributes
			{
				name="mothership1LeaveTrigger";
				onActivation="playSound3D [getMissionPath ""mothershipLeave.ogg"", mothership1, false, getPosASL mothership1, 20, 1, 12000];   " \n "[] Spawn {  " \n " private _position = getPosASL mothership1;   " \n " [{deleteVehicle mothership1;}, mothership1, 45] call CBA_fnc_waitAndExecute;   " \n "   " \n " sleep 30;   " \n "   " \n " _lightIn = ""#lightpoint"" createVehicleLocal [0,0,0];   " \n "    _lightIn attachTo [mothership1, [0, 0, 0]];   " \n "    _lightIn setLightColor [0.3, 0.3, 1];   " \n "    _lightIn setLightAmbient [0.3, 0.3, 1];   " \n "    _lightIn setLightBrightness 0;   " \n "    _lightIn setLightDayLight true;   " \n "   " \n "    private _i = 0;   " \n "       " \n "    while {_i < 200} do {   " \n "        sleep 0.01;               " \n "        _lightIn setLightBrightness _i;   " \n "        _i = _i + 0.1   " \n "    };   " \n " waitUntil { sleep 1; not alive mothership1 };   " \n "    deleteVehicle _lightIn;   " \n "};   " \n "[] Spawn {   " \n " sleep 40;   " \n " _iniPos = getPosATL mothership1;   " \n "    _Z1 = _iniPos#2;   " \n "   " \n "    _verticalMovement = 30000;   " \n "   " \n "    _Z2 = _Z1 + _verticalMovement;   " \n "   " \n "    private _i = 0.01;   " \n "    while { _Z1 <= _Z2 } do    " \n "    {       " \n "        mothership1 setPosATL [_iniPos#0, _iniPos#1, _Z1];   " \n "        sleep 0.001;   " \n "        _Z1 = _Z1 + _i;   " \n "        _i = _i + 100;   " \n "    };   " \n "    sleep 1;" \n "    playSound3D [getMissionPath ""mothershipLeave.ogg"", dish1, false, getPosASL dish1, 3, 1, 1000, 37.5];   " \n "    0.2 setWindDir 240; " \n "    0.2 setWindForce 1; " \n "    0.2 setWindStr 1; " \n "    sleep 5; " \n "    8 setWindDir 135; " \n "    8 setWindForce 0.5; " \n "    8 setWindStr 0.5; " \n "};";
				sizeA=4000;
				sizeB=4000;
				sizeC=4000;
				timeout[]={240,240,240};
				activationBy="ANYPLAYER";
			};
			id=145;
			type="EmptyDetectorAreaR250";
			atlOffset=179.76401;
		};
